{
  "name": "magno-clean-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "test": "node --test dist/**/*.test.js",
    "start": "node dist/index.js",
    "prisma:migrate": "prisma migrate deploy",
    "seed:admin": "ts-node --transpile-only src/scripts/seedAdmin.ts",
    "seed:products": "ts-node-dev --transpile-only src/seedProducts.ts",
    "import:products": "ts-node --transpile-only src/scripts/importMagnoProducts.ts ../../magno-products.json",
    "inventory:release-expired": "node dist/scripts/releaseExpiredReservations.js",
    "inventory:release-expired:dev": "ts-node --transpile-only src/scripts/releaseExpiredReservations.ts",
    "backup:database": "sh scripts/backupDatabase.sh",
    "test:inventory": "ts-node --transpile-only src/scripts/testInventory.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.71.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mercadopago": "^3.5.0",
    "multer": "^2.2.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
