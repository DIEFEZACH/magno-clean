NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_SECONDS=900
REFRESH_TOKEN_EXPIRES_DAYS=30
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10
CHECKOUT_RATE_LIMIT_MAX=30
CHECKOUT_ENABLED=false
WEBHOOK_RATE_LIMIT_MAX=600
# Debe ser true en producción. Use false sólo para desarrollo local si el proveedor lo exige.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Opcional. Si se omite, error tracking permanece desactivado.
ERROR_TRACKING_DSN=
# Sólo para ejecutar backups lógicos desde un job controlado.
BACKUP_DIRECTORY=/absolute/path/to/encrypted-backups
BACKUP_RETENTION_DAYS=30
ADMIN_NAME=Magno Clean Admin
ADMIN_EMAIL=admin@magnoclean.com
ADMIN_PASSWORD=replace-with-a-strong-password
MERCADO_PAGO_ACCESS_TOKEN=TEST-your-access-token
MERCADO_PAGO_WEBHOOK_SECRET=replace-with-your-webhook-secret
DEFAULT_CURRENCY=MXN
MAX_ORDER_ITEMS=100
MAX_ITEM_QUANTITY=100
INVENTORY_RESERVATION_MINUTES=30
# URL HTTPS pública del backend en producción, sin slash final.
API_PUBLIC_URL=https://api.example.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images
SUPABASE_PRODUCT_MEDIA_BUCKET=product-media
PRODUCT_IMAGE_MAX_BYTES=5242880
PRODUCT_IMAGE_MAX_COUNT=20
