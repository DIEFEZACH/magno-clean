generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  FAILED
}

enum InventoryMovementType {
  INITIAL
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  CANCELLATION
  RESERVATION
  RELEASE
}

enum InventoryReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  RETURNED
}

enum WebsiteContentStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
}

enum WebsiteContentSection {
  BENEFIT
  APPLICATION
  USAGE
  DILUTION
  PRECAUTION
  PICTOGRAM
  SEO_KEYWORD
}

enum WebsiteContentSourceLayer {
  SOURCE_TECHNICAL
  DERIVED_COMMERCIAL
}

enum WebsiteContentMediaRole {
  HERO
  BENEFITS
  USAGE
  SAFETY
  INFOGRAPHIC
}

enum ContentExtractionConfidence {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                        String                   @id @default(cuid())
  name                      String
  email                     String                   @unique
  passwordHash              String
  role                      Role                     @default(CUSTOMER)
  active                    Boolean                  @default(true)
  refreshTokens             RefreshToken[]
  inventoryMovements        InventoryMovement[]
  orderNotes                OrderNote[]
  orderStatusChanges        OrderStatusHistory[]
  websiteContentCreated     WebsiteContentRevision[] @relation("WebsiteContentCreatedBy")
  websiteContentReviewed    WebsiteContentRevision[] @relation("WebsiteContentReviewedBy")
  websiteContentApproved    WebsiteContentRevision[] @relation("WebsiteContentApprovedBy")
  websiteContentPublished   WebsiteContentRevision[] @relation("WebsiteContentPublishedBy")
  contentConflictsConfirmed WebsiteContentRevision[] @relation("WebsiteContentConflictsConfirmedBy")
  websiteContentSources     WebsiteContentSource[]   @relation("WebsiteContentSourceCreatedBy")
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @default(now()) @updatedAt
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Order {
  id              String                 @id @default(cuid())
  idempotencyKey  String?                @unique
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String
  city            String
  state           String
  postalCode      String
  country         String
  subtotal        Float
  shipping        Float                  @default(0)
  discount        Float                  @default(0)
  tax             Float                  @default(0)
  total           Float
  currency        String
  status          OrderStatus            @default(PENDING)
  items           OrderItem[]
  payment         Payment?
  reservations    InventoryReservation[]
  notes           OrderNote[]
  statusHistory   OrderStatusHistory[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @default(now()) @updatedAt

  @@index([customerEmail])
  @@index([status, createdAt])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productId   String
  productName String
  productCode String
  quantity    Int
  unitPrice   Float
  subtotal    Float
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                   String        @id @default(cuid())
  orderId              String        @unique
  provider             String
  providerPaymentId    String?       @unique
  providerPreferenceId String?       @unique
  status               PaymentStatus @default(PENDING)
  rawResponse          Json?
  order                Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @default(now()) @updatedAt
}

model Product {
  id                    String                 @id @default(cuid())
  slug                  String                 @unique
  code                  String                 @unique
  brand                 String                 @default("Magno Clean")
  name                  String
  category              String
  description           String
  imageUrl              String?
  costPrice             Float                  @default(0)
  unitPrice             Float                  @default(0)
  wholesalePrice        Float                  @default(0)
  retailPrice           Float                  @default(0)
  digitalPrice          Float                  @default(0)
  price                 Float
  oldPrice              Float?
  badge                 String?
  featured              Boolean                @default(false)
  active                Boolean                @default(true)
  stock                 Int                    @default(0)
  reservedStock         Int                    @default(0)
  minStock              Int                    @default(5)
  familyId              String?
  variantLabel          String?
  variantSortOrder      Int                    @default(0)
  family                ProductFamily?         @relation(fields: [familyId], references: [id], onDelete: SetNull)
  websiteContent        WebsiteContent?
  images                ProductImage[]
  inventoryMovements    InventoryMovement[]
  inventoryReservations InventoryReservation[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @default(now()) @updatedAt

  @@unique([familyId, variantLabel])
  @@index([familyId, variantSortOrder])
}

model ProductFamily {
  id                 String          @id @default(cuid())
  slug               String          @unique
  name               String
  brand              String
  category           String
  description        String
  imageUrl           String?
  badge              String?
  featured           Boolean         @default(false)
  active             Boolean         @default(true)
  variantType        String          @default("Presentación")
  alwaysShowAsFamily Boolean         @default(false)
  products           Product[]
  websiteContent     WebsiteContent?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt

  @@index([active])
  @@index([featured])
}

model WebsiteContent {
  id                  String                   @id @default(cuid())
  familyId            String?                  @unique
  productId           String?                  @unique
  publishedRevisionId String?                  @unique
  family              ProductFamily?           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  product             Product?                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  publishedRevision   WebsiteContentRevision?  @relation("PublishedWebsiteContentRevision", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  revisions           WebsiteContentRevision[] @relation("WebsiteContentRevisions")
  sources             WebsiteContentSource[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @default(now()) @updatedAt
}

model WebsiteContentRevision {
  id                        String                @id @default(cuid())
  contentId                 String
  version                   Int
  status                    WebsiteContentStatus  @default(DRAFT)
  title                     String?
  shortDescription          String?
  longDescription           String?
  seoTitle                  String?
  seoDescription            String?
  technicalSheetUrl         String?
  sdsUrl                    String?
  createdById               String
  reviewedById              String?
  approvedById              String?
  publishedById             String?
  conflictsConfirmedById    String?
  conflictsConfirmationNote String?
  reviewedAt                DateTime?
  approvedAt                DateTime?
  publishedAt               DateTime?
  conflictsConfirmedAt      DateTime?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @default(now()) @updatedAt
  content                   WebsiteContent        @relation("WebsiteContentRevisions", fields: [contentId], references: [id], onDelete: Cascade)
  publishedFor              WebsiteContent?       @relation("PublishedWebsiteContentRevision")
  createdBy                 User                  @relation("WebsiteContentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy                User?                 @relation("WebsiteContentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedBy                User?                 @relation("WebsiteContentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  publishedBy               User?                 @relation("WebsiteContentPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  conflictsConfirmedBy      User?                 @relation("WebsiteContentConflictsConfirmedBy", fields: [conflictsConfirmedById], references: [id], onDelete: SetNull)
  entries                   WebsiteContentEntry[]
  faq                       WebsiteContentFaq[]
  media                     WebsiteContentMedia[]

  @@unique([contentId, version])
  @@index([contentId, status])
  @@index([createdById])
  @@index([reviewedById])
  @@index([approvedById])
  @@index([publishedById])
  @@index([conflictsConfirmedById])
}

model WebsiteContentMedia {
  id               String                  @id @default(cuid())
  revisionId       String
  role             WebsiteContentMediaRole
  bucket           String
  storagePath      String
  alt              String
  position         Int                     @default(0)
  width            Int?
  height           Int?
  byteSize         Int
  sha256           String
  mimeType         String
  reviewRequired   Boolean                 @default(false)
  editorialWarning String?
  createdAt        DateTime                @default(now())
  revision         WebsiteContentRevision  @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, role, position])
  @@unique([revisionId, bucket, storagePath])
  @@index([revisionId, role, position])
}

model WebsiteContentEntry {
  id         String                 @id @default(cuid())
  revisionId String
  section    WebsiteContentSection
  value      String
  position   Int                    @default(0)
  revision   WebsiteContentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([revisionId, section, position])
}

model WebsiteContentFaq {
  id         String                 @id @default(cuid())
  revisionId String
  question   String
  answer     String
  position   Int                    @default(0)
  revision   WebsiteContentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([revisionId, position])
}

model WebsiteContentSource {
  id             String                       @id @default(cuid())
  contentId      String
  layer          WebsiteContentSourceLayer
  sourceFile     String?
  sourceSha256   String?
  data           Json
  reviewRequired Boolean                      @default(false)
  confidence     ContentExtractionConfidence?
  createdById    String
  createdAt      DateTime                     @default(now())
  content        WebsiteContent               @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdBy      User                         @relation("WebsiteContentSourceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([contentId, layer])
  @@index([createdById])
  @@index([sourceSha256])
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  url         String
  alt         String?
  position    Int      @default(0)
  storagePath String?  @unique
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([productId, position])
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  authorId  String
  content   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderStatusHistory {
  id        String       @id @default(cuid())
  orderId   String
  from      OrderStatus?
  to        OrderStatus
  actorId   String?
  reason    String?
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor     User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())

  @@index([orderId, createdAt])
}

model CompanySettings {
  id              String   @id @default("default")
  companyName     String   @default("Magno Clean")
  logoUrl         String?
  email           String?
  phone           String?
  website         String?
  fiscalName      String?
  taxId           String?
  fiscalAddress   String?
  facebookUrl     String?
  instagramUrl    String?
  taxRate         Float    @default(0)
  shippingFee     Float    @default(0)
  freeShippingMin Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model InventoryReservation {
  id        String                     @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  status    InventoryReservationStatus @default(ACTIVE)
  expiresAt DateTime
  order     Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @default(now()) @updatedAt

  @@unique([orderId, productId])
  @@index([status, expiresAt])
  @@index([productId, status])
}

model InventoryMovement {
  id                 String                @id @default(cuid())
  productId          String
  type               InventoryMovementType
  quantity           Int
  reason             String?
  orderId            String?
  createdById        String?
  stockAfter         Int
  reservedStockAfter Int
  product            Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy          User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime              @default(now())

  @@index([productId, createdAt])
  @@index([orderId])
  @@index([createdById])
}
